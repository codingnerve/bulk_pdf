# --- Database ---------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/pdflinker

# --- Auth -------------------------------------------------------------------
# At least 32 random characters. Generate with: openssl rand -base64 48
AUTH_SECRET=
# Public origin of this app (used for CSRF origin checks, cookies, reset links)
APP_URL=http://localhost:3000
# Optional: comma-separated Origins allowed to call /api/v1 with Bearer tokens
# (e.g. a future Chrome extension: chrome-extension://<extension-id>)
ALLOWED_EXTENSION_ORIGINS=

# --- Object storage: Cloudflare R2 by default, or ANY S3-compatible store ------
# (server-side only, never exposed to the browser). The R2_ prefix is historical.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Custom domain connected to the bucket, e.g. files.example.com
R2_PUBLIC_DOMAIN=

# Only for non-R2 stores (SeaweedFS, Backblaze B2, AWS S3, ...). With these set, R2_ACCOUNT_ID is not needed.
STORAGE_ENDPOINT=
# Endpoint BROWSERS use for presigned URLs, if different from the one the server uses (e.g. Docker)
STORAGE_PUBLIC_ENDPOINT=
STORAGE_REGION=
STORAGE_FORCE_PATH_STYLE=

# --- Upload limits ------------------------------------------------------------
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_BATCH=100
UPLOAD_CONCURRENCY=4
# Files larger than this use S3 multipart upload
MULTIPART_THRESHOLD_MB=20
MULTIPART_PART_SIZE_MB=10

# --- Maintenance ------------------------------------------------------------
# Shared secret for POST /api/v1/uploads/cleanup (call from a cron job)
CRON_SECRET=
