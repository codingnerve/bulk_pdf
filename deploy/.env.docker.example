# Copy to ../.env (next to docker-compose.yml) and fill in. Never commit the real file.
#
# --- Domains: create three DNS A/AAAA records pointing at this server -------------------------
#   Trying it on one machine first? Use:  APP_DOMAIN=localhost  FILES_DOMAIN=files.localhost  S3_DOMAIN=s3.localhost
APP_DOMAIN=pdf.example.com
FILES_DOMAIN=files.example.com
S3_DOMAIN=s3.example.com

# --- Secrets: generate each with  openssl rand -base64 36  (use letters/digits only for passwords) ---
MONGO_PASSWORD=
AUTH_SECRET=
CRON_SECRET=
# Object-storage credentials (any strings you like; used by the app and the storage service)
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Optional ------------------------------------------------------------------------------------
S3_BUCKET=pdflinker
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_BATCH=100
UPLOAD_CONCURRENCY=4
# e.g. chrome-extension://<extension-id>
ALLOWED_EXTENSION_ORIGINS=
